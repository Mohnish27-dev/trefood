{
  "name": "@trefood/backend",
  "version": "0.1.0",
  "private": true,
  "description": "TREFOOD API. Owns MongoDB, every business rule, Razorpay, and the cron jobs. The frontend never reaches past this service.",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint",
    "test": "vitest run"
  },
  "dependencies": {
    "@sentry/node": "^10.73.0",
    "@trefood/shared": "*",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "mongodb": "^7.6.0",
    "razorpay": "^2.9.6",
    "web-push": "^3.6.7",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "typescript-eslint": "^8",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
