# TREFOOD backend — every secret in the system lives here and nowhere else.
# Copy to .env and fill in. src/env.ts refuses to boot without these.

NODE_ENV=development
PORT=4000

# Browser origins allowed to call this API, comma-separated.
# This is real access control, not boilerplate — the frontend is a different origin now.
CORS_ORIGINS=http://localhost:3000

# ── Database ──────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=trefood

# ── Supabase ──────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Razorpay ──────────────────────────────────────────
# Use rzp_test_* keys until docs/PHASES.md Phase 15 go-live.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@trefood.in

# ── Cron protection ───────────────────────────────────
# Required header on every /cron/* route. Minimum 32 chars.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# ── Observability (optional) ──────────────────────────
SENTRY_DSN=
