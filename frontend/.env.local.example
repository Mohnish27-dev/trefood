# TREFOOD frontend — copy to .env.local and fill in.
# Every value here ships to the browser by design. Secrets live in backend/.env.

# The seam between the two services: base URL of the TREFOOD API.
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── Supabase (public half only — the service-role key is backend-only) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Web Push (public half only) ───────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ── Observability (optional) ──────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ── Sentry source-map upload (build time only) ────────
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ── App ───────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
