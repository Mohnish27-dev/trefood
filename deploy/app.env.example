# ══════════════════════════════════════════════════════════════════════
#  TREFOOD — runtime environment for the production container.
#
#  Copy to /opt/trefood/app.env ON THE SERVER and fill in. It is never
#  committed and never passes through GitHub: these are read at runtime,
#  so they do not need to be in the image and must not be.
#
#  What is NOT here: every NEXT_PUBLIC_* except APP_URL. Those are inlined
#  into the browser bundle at build time, so they are set as repository
#  Variables and passed as Docker build args instead. Putting one here has
#  no effect on the client — a genuinely confusing failure to debug, which
#  is why the two sets are kept apart.
#
#  Validated by src/lib/env.ts at boot. A missing required value crashes
#  the container with a readable report rather than half-working.
#
#  After editing, apply it with:  cd /opt/trefood && docker compose up -d
# ══════════════════════════════════════════════════════════════════════

# ── Database (REQUIRED) ───────────────────────────────────────────────
# Production is MongoDB Atlas. Whitelist the Lightsail instance's static
# IP in Atlas > Network Access, or the container boots and every request
# times out against a firewall.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=trefood
MONGODB_MAX_POOL_SIZE=10

# ── Provider seams ────────────────────────────────────────────────────
#   AUTH_PROVIDER:    stub | trefood
#   PAYMENT_PROVIDER: stub | phonepe | paytm
# `AUTH_PROVIDER=stub` is now refused outright in production by env.ts —
# it performs no credential check at all. PAYMENT_PROVIDER has no such
# guard, so check what the box is actually running before copying this
# file over it:
#   docker inspect trefood-app --format '{{range .Config.Env}}{{println .}}{{end}}'
AUTH_PROVIDER=trefood
PAYMENT_PROVIDER=paytm

# ── Google sign-in ────────────────────────────────────────────────────
# Google Cloud console -> Credentials -> OAuth client ID -> Web application.
# The authorised redirect URI must be exactly NEXT_PUBLIC_APP_URL plus the
# callback path, `www` and all — this deployment means:
#   https://www.trefood.in/api/auth/google/callback
# Set both, or neither: a half-configured client renders a button that
# dead-ends on Google's own error page.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Outbound mail: the Zoho mailbox on the trefood.in domain ──────────
# Verification codes and password resets go out over this mailbox, not a
# shared third-party quota. Host must match the Zoho region the account
# was created in: smtp.zoho.in (India), smtp.zoho.com, smtp.zoho.eu.
#
# SMTP_PASSWORD is an APP-SPECIFIC password from
# Zoho Mail -> Settings -> Security -> App Passwords. With two-factor
# authentication on, the account password is refused by SMTP outright.
SMTP_HOST=smtp.zoho.in
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=TREFOOD <no-reply@trefood.in>
# Must be `smtp` here. `console` prints codes to the log and the app
# refuses to boot with it in production.
MAIL_TRANSPORT=smtp

# ── Paytm (required when PAYMENT_PROVIDER=paytm) ──────────────────────
# Test and production credentials are separate and CANNOT be mixed. The
# MID, the key, the website name and the environment must all come from
# the same column of the dashboard, or every transaction fails checksum
# validation with an error that does not say why.
#
#   Test:        PAYTM_ENVIRONMENT=staging     PAYTM_WEBSITE=WEBSTAGING
#                MID + key from "Test API Details"
#   Production:  PAYTM_ENVIRONMENT=production  PAYTM_WEBSITE=DEFAULT
#                MID + key from "Production API Details"
#
# Set to the test pair below, which is what this deployment currently
# runs. Switching to live money is these four lines and nothing else.
PAYTM_MID=
PAYTM_MERCHANT_KEY=
PAYTM_WEBSITE=WEBSTAGING
PAYTM_ENVIRONMENT=staging
# Optional; defaults to NEXT_PUBLIC_APP_URL + /api/webhooks/paytm.
# Paytm will not accept an http:// callback for production credentials,
# so this has to be an https:// origin before the switch above.
PAYTM_CALLBACK_URL=

# ── PhonePe (required when PAYMENT_PROVIDER=phonepe) ──────────────────
PHONEPE_MERCHANT_ID=
PHONEPE_MERCHANT_SECRET=
PHONEPE_WEBHOOK_SECRET=

# ── Web Push ──────────────────────────────────────────────────────────
# The private half only. The public key is a build-time Variable — and
# the two must be from the same generated pair, or every push silently
# fails to deliver.
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@trefood.in

# ── Cron protection (REQUIRED) ────────────────────────────────────────
# Required header on every /api/cron/* route. Generate a real one:
#     openssl rand -hex 32
# env.ts refuses to boot in production if this is still the dev
# placeholder, deliberately.
CRON_SECRET=

# ── App ───────────────────────────────────────────────────────────────
# The canonical origin, no trailing slash. Read server-side as well as
# inlined at build time; keep this identical to the NEXT_PUBLIC_APP_URL
# repository Variable or the server and the browser will disagree about
# where the site lives.
NEXT_PUBLIC_APP_URL=https://www.trefood.in
