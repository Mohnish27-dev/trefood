# TREFOOD — environment template.
# Copy to .env.local and fill in. Every key here is required unless marked optional;
# src/lib/env.server.ts refuses to boot without them. See docs/PROJECT_STRUCTURE.md §5.

# ── Database ──────────────────────────────────────────
MONGODB_URI=
MONGODB_DB=trefood

# ── Supabase: auth + image storage ────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only, never NEXT_PUBLIC

# ── Razorpay ──────────────────────────────────────────
# Use rzp_test_* keys until docs/PHASES.md Phase 15 go-live.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=                # server only
RAZORPAY_WEBHOOK_SECRET=            # server only

# ── Web Push (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@trefood.in

# ── Cron protection ───────────────────────────────────
# Required header on every /api/cron/* route. Minimum 32 chars.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# ── Observability (optional: absent means no reporting, not a broken app) ──
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ── Sentry source-map upload (build time only; set in Vercel, not locally) ──
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ── App ───────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
