# ══════════════════════════════════════════════════════════════════════
#  TREFOOD — environment
#  Copy to .env.local and fill in. Validated by src/lib/env.ts at boot.
#  A missing required var crashes the app with a readable message, on
#  purpose. Discovering an unset secret at 1 AM during a payment surge
#  is not the moment to learn it was never set.
#
#  Every value below is either a working local default or a blank with
#  the expected SHAPE shown above it. Blank is meaningful: an optional
#  var left empty is read as "not configured" and the feature it powers
#  is switched off cleanly, rather than half-wired with a placeholder
#  that looks real. Do not paste the example shapes in as-is.
#
#  NODE_ENV is deliberately absent — Next sets it per command, and
#  overriding it here is how a dev build ends up thinking it is prod.
# ══════════════════════════════════════════════════════════════════════

# ── Database (REQUIRED) ───────────────────────────────────────────────
# Pick ONE:
#   npm run db:local   (no Docker, no account) -> mongodb://127.0.0.1:27017/trefood
#   npm run db:up      (Docker compose)        -> mongodb://trefood:trefood@localhost:27017/trefood?authSource=admin
#   MongoDB Atlas                              -> mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/trefood
MONGODB_DB=trefood
# Atlas free tier ceiling. Raise this with the cluster tier, never in code.
MONGODB_MAX_POOL_SIZE=10

# ── Provider seams ────────────────────────────────────────────────────
#   AUTH_PROVIDER:    stub | trefood
#     stub    — the seeded demo picker, no credentials needed. Refused in production.
#     trefood — the real thing: email + password, Google, and emailed codes.
#   PAYMENT_PROVIDER: stub | phonepe | paytm
AUTH_PROVIDER=trefood
PAYMENT_PROVIDER=stub

# ── Google sign-in ─────────────────────────────────────────────────────
# Google Cloud console -> APIs & Services -> Credentials -> OAuth client ID,
# application type "Web application". Both values, or neither.
#
# Authorised redirect URI (must match byte for byte, including the scheme):
#   http://localhost:3000/api/auth/google/callback      (development)
#   https://www.trefood.in/api/auth/google/callback     (production, note the www)
#
# Authorised JavaScript origin:
#   http://localhost:3000  /  https://www.trefood.in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Set to true only when the two values above are filled in. It is what decides
# whether the "Continue with Google" button is rendered at all.
NEXT_PUBLIC_GOOGLE_ENABLED=false

# ── Outbound mail: the Zoho mailbox on trefood.in ──────────────────────
# Verification codes go out over our own domain, not a shared provider quota.
#
# Zoho Mail region matters — the host must match where the account was created:
#   India     smtp.zoho.in       (a .in domain usually lands here)
#   Global    smtp.zoho.com
#   Europe    smtp.zoho.eu
#
# SMTP_PASSWORD is an APP-SPECIFIC password, never the account password.
# Zoho Mail -> Settings -> Security -> App Passwords -> Generate.
# With two-factor authentication on the mailbox, the account password is
# refused by SMTP outright.
SMTP_HOST=smtp.zoho.in
# 465 = implicit TLS (recommended). 587 = STARTTLS.
SMTP_PORT=465
# Leave blank to derive it from the port. Set explicitly only to override.
SMTP_SECURE=
# The full mailbox address, e.g. no-reply@trefood.in
SMTP_USER=
SMTP_PASSWORD=
# The From header. Zoho refuses to send as an address this mailbox does not own,
# so the address here must be the mailbox itself or one of its verified aliases.
MAIL_FROM=TREFOOD <no-reply@trefood.in>
# smtp | console. `console` prints codes to the server log instead of sending
# them, so the whole flow is walkable with no mailbox. Refused in production.
MAIL_TRANSPORT=smtp

# ── PhonePe (required when PAYMENT_PROVIDER=phonepe) ───────────────────
# D8 — merchant business account, dynamic QR + UPI, direct-to-bank.
# shape: M22XXXXXXXXXXXX
PHONEPE_MERCHANT_ID=
# shape: a UUID issued in the merchant dashboard
PHONEPE_MERCHANT_SECRET=
PHONEPE_WEBHOOK_SECRET=

# ── Paytm (required when PAYMENT_PROVIDER=paytm) ─────────────────────────
# Test and production credentials are separate and cannot be mixed.
# Test:       staging + WEBSTAGING + the MID/key under "Test API Details"
# Production: production + DEFAULT (unless Paytm assigned another website)
#             + the MID/key under "Production API Details"
# shape: AbcDef12345678901234
PAYTM_MID=
# shape: a 16-char alphanumeric secret from the same dashboard panel
PAYTM_MERCHANT_KEY=
PAYTM_WEBSITE=WEBSTAGING
PAYTM_ENVIRONMENT=staging
# Optional override; otherwise NEXT_PUBLIC_APP_URL + /api/webhooks/paytm is used.
# shape: https://www.trefood.in/api/webhooks/paytm
PAYTM_CALLBACK_URL=

# ── Web Push (generate with: npx web-push generate-vapid-keys) ─────────
# The public key is inlined into the client bundle; the private one is not.
# shape: BEl62iUYgUivxIkv69yViEuiBIa-Ib9-SkFbx4gpXDkLdzTOsB...
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# shape: UUxIrqNQq4sK2G8U0sCTdSC_1sD1uJlkc6XkYUlLcNw
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@yourdomain.in

# ── Support channels ──────────────────────────────────────────────────
# Shown on /account/support and linked from the legal pages. A channel
# left blank is NOT rendered — better a missing row than a published
# number nobody watches, because the student then waits at the wrong door.
# The email is the one channel with a default, so support is never a
# dead end on a fresh install.
NEXT_PUBLIC_SUPPORT_EMAIL=tregoinworks@gmail.com
# Digits only, country code included, no "+" and no spaces — this is
# pasted straight into a wa.me link. shape: 919876543210
NEXT_PUBLIC_SUPPORT_WHATSAPP=
# Rendered as a tap-to-call row, so write it the way it should be dialled.
# shape: +919876543210
NEXT_PUBLIC_SUPPORT_PHONE=

# ── Cron protection ───────────────────────────────────────────────────
# Required header on every /api/cron/* route. Not obscurity - a real secret.
CRON_SECRET=dev-only-change-me

# ── Polling intervals, milliseconds ───────────────────────────────────
# Env-driven so the release valve under read load is a config change,
# not a deploy. ARCH section 8.
NEXT_PUBLIC_POLL_VENDOR_MS=5000
NEXT_PUBLIC_POLL_STUDENT_MS=8000
NEXT_PUBLIC_POLL_ADMIN_MS=10000

# ── Observability (optional) ──────────────────────────────────────────
# shape: https://<key>@o0000000.ingest.sentry.io/0000000
NEXT_PUBLIC_SENTRY_DSN=
# shape: phc_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ── App ───────────────────────────────────────────────────────────────
# No trailing slash. In production this is the canonical origin, and it is
# what the Paytm callback and the push payloads build their URLs from.
NEXT_PUBLIC_APP_URL=http://localhost:3000
